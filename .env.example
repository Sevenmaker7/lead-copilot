# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Postgres (backing DB for n8n) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me_to_something_random
POSTGRES_DB=n8n

# --- n8n ---
# Leave blank on first run - scripts/start.ps1 fills this in automatically
# once the tunnel (localhost.run) assigns its random public hostname.
N8N_PUBLIC_HOST=
# Generate with: powershell -c "[guid]::NewGuid().ToString()"
N8N_ENCRYPTION_KEY=change_me_to_a_random_guid
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me

# --- Gemini ---
# https://aistudio.google.com/apikey - free tier, no credit card required.
# Used by n8n's HTTP Request nodes (the 4 agents) AND rag-service (embeddings).
GEMINI_API_KEY=

# --- Telegram ---
# Create a bot via https://t.me/BotFather (/newbot), paste the token it gives you.
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id (message https://t.me/userinfobot to get it) -
# this is who receives Hot-lead approve/edit/reject pings.
TELEGRAM_SALES_CHAT_ID=

# --- Airtable ---
# https://airtable.com/create/tokens - personal access token with data.records:read/write
# scope on the base you create for this project.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads
