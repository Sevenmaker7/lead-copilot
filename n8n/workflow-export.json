                      "position":  [
                                       1980,
                                       0
                                   ],
                      "parameters":  {
                                         "jsCode":  "const prior = $(\"Parse Qualifier\").item.json;\nconst resp = $input.first().json;\nconst results = resp.results || [];\nconst context = results.map(r =\u003e \"[\" + r.source + \" / \" + r.heading + \"]\\n\" + r.text).join(\"\\n\\n\");\nconst sources = [...new Set(results.map(r =\u003e r.source))];\nreturn [{ json: Object.assign({}, prior, { rag_context: context, rag_sources: sources }) }];",
                                         "mode":  "runOnceForAllItems"
                                     }
