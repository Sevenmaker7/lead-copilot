                                         "authentication":  "genericCredentialType",
                                         "jsonBody":  "={{ JSON.stringify({ systemInstruction: { parts: [{ text: $json.prompts.responder }] }, contents: [{ parts: [{ text: \"Extracted lead JSON:\\n\" + JSON.stringify($json.extracted, null, 2) + \"\\n\\nQualifier output:\\n\" + JSON.stringify({score:$json.score,temperature:$json.temperature,reasoning:$json.scoring_reasoning}, null, 2) + \"\\n\\nRetrieved context:\\n\" + $json.rag_context }] }], generationConfig: { responseMimeType: \"application/json\", temperature: 0.2 } }) }}",
                                         "url":  "https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-lite-latest:generateContent",
                                         "options":  {

