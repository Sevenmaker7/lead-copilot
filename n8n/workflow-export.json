                  {
                      "id":  "10000000-0000-0000-0000-000000000008",
                      "name":  "Parse QA and Resolve",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       2860,
                                       0
                                   ],
                      "parameters":  {
                                         "jsCode":  "const prior = $(\"Parse Responder\").item.json;\nconst resp = $input.first().json;\nlet qa;\ntry {\n  const raw = resp.candidates[0].content.parts[0].text;\n  qa = JSON.parse(raw);\n} catch (e) {\n  throw new Error(\"QA reviewer agent returned invalid JSON: \" + e.message);\n}\n\nconst verdict = qa.verdict; // \"Pass\" | \"Fixed\" | \"Failed\"\nconst finalDraft = verdict === \"Failed\" ? null : (verdict === \"Fixed\" ? qa.corrected_draft : prior.draft_v1);\nconst needsPing = verdict === \"Failed\" || prior.temperature === \"Hot\";\nconst pingReason = verdict === \"Failed\" ? \"qa_failed\" : (prior.temperature === \"Hot\" ? \"hot_lead\" : \"none\");\n\nconst fire = \"\\u{1F525}\";\nconst warn = \"\\u26A0\\uFE0F\";\nconst header = pingReason === \"qa_failed\"\n  ? (warn + \" Needs manual review (auto-processing flagged this one)\")\n  : (fire + \" Hot lead\");\nconst telegramText = header + \"\\n\\n\"\n  + \"Score: \" + prior.score + \"/100\\n\"\n  + \"Reasoning: \" + prior.scoring_reasoning + \"\\n\\n\"\n  + \"Draft reply:\\n\" + (finalDraft || \"(none - see QA notes)\") + \"\\n\\n\"\n  + \"QA notes: \" + qa.notes;\n\nreturn [{ json: Object.assign({}, prior, {\n  qa_verdict: verdict,\n  qa_notes: qa.notes,\n  final_draft: finalDraft,\n  needs_telegram_ping: needsPing,\n  ping_reason: pingReason,\n  telegram_text: telegramText,\n  processing_failed: false,\n  processed_at: new Date().toISOString()\n}) }];",
                                         "mode":  "runOnceForAllItems"
                                     }
                  },
